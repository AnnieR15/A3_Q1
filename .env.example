# Connection settings for the PostgreSQL database.
# Copy this file to ".env" and change the values to match your server.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
# The password of the PGUSER account on your PostgreSQL server.
# (With the Docker option in the README, this is also the password the
# database container is created with.)
PGPASSWORD=postgres
PGDATABASE=students_db
